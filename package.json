{
  "name": "faze-odyssey",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "dev": "npm-run-all --parallel dev:server dev:web",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "e2e": "npm run e2e -w server",
    "demo": "npm run build -w web && npm-run-all --parallel dev:server preview:web",
    "preview:web": "npm run preview -w web"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
